{
  "name": "obsidian-collab",
  "version": "1.0.0",
  "description": "Peer-to-peer collaborative editing sessions for Obsidian notes",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "worker": "npm --prefix worker run dev -- --ip 0.0.0.0",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test-deps": "playwright install chromium",
    "test": "vitest run",
    "test-network": "VITEST_NETWORK=1 VITE_ONLINE=1 vitest run",
    "e2e": "node scripts/e2e.mjs",
    "phone": "cp main.js manifest.json styles.css \"$HOME/Library/Mobile Documents/iCloud~md~obsidian/Documents/obsidian-collab-phone/.obsidian/plugins/collab/\"",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint .",
    "postinstall": "patch-package"
  },
  "keywords": [],
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.6",
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.15.17",
    "@vitest/browser-playwright": "^5.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "globals": "^17.6.0",
    "jiti": "^2.6.1",
    "node-turn": "^0.0.6",
    "obsidian": "latest",
    "patch-package": "^8.0.1",
    "playwright": "^1.63.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "fast-diff": "^1.3.0",
    "lib0": "^0.2.117",
    "trystero": "^0.25.4",
    "y-codemirror.next": "^0.3.6",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32"
  }
}
