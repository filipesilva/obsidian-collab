# vscode
.vscode 

# Intellij
*.iml
.idea

# npm
node_modules

# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
main.js

# Exclude sourcemaps
*.map

# obsidian
data.json

# Exclude macOS Finder (System Explorer) View States
.DS_Store

# vitest browser cache
.vitest

# worker
worker/node_modules
worker/.wrangler
.wrangler

# test vaults: keep their config, not what Obsidian and the plugin write while running
test-vaults/*/.obsidian/app.json
test-vaults/*/.obsidian/appearance.json
test-vaults/*/.obsidian/graph.json
test-vaults/**/*.md
test-vaults/*/.obsidian/workspace.json
test-vaults/*/.obsidian/workspace-mobile.json
test-vaults/*/.obsidian/plugins
test-vaults/*/.trash
